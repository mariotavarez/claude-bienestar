{
  "name": "Bienestar Sesión 1",
  "workspaceFolder": "/workspaces/bienestar",
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          "**/node_modules": true
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.fontSize": 16,
        "editor.wordWrap": "on",
        "workbench.startupEditor": "readme"
      },
      "extensions": []
    }
  },
  "remoteEnv": {
    "PATH": "/home/node/.local/bin:${containerEnv:PATH}"
  },
  "postStartCommand": "npm run status -- --container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/bienestar,type=bind,consistency=cached",
  "runArgs": [
    "--init",
    "--publish",
    "127.0.0.1:4180:4173"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "DISABLE_AUTOUPDATER": "1"
  },
  "mounts": [
    "source=bienestar-sesion1_dependencies,target=/workspaces/bienestar/node_modules,type=volume",
    "source=bienestar-sesion1_claude_config,target=/home/node/.claude,type=volume"
  ],
  "overrideCommand": false
}
