{
  "name": "bienestar-modulo-2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "status": "node scripts/status.mjs",
    "baseline": "node --test tests/baseline.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:web": "node --test tests/selection.test.mjs",
    "test:data": "node scripts/python-task.mjs -m unittest discover -s data/tests -v",
    "coverage": "node --experimental-test-coverage --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "data": "node scripts/python-task.mjs data/report.py",
    "evidence": "node scripts/evidence.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
